[Unit]
Description=envlog ingest service
Documentation=https://github.com/danieljurnove-ctrl/env-logger
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=envlog
Group=envlog
WorkingDirectory=/opt/envlog
# Holds ENVLOG_TOKEN, and optionally ENVLOG_DB / ENVLOG_BIND / ENVLOG_PORT.
# Must be root-owned and mode 0600: it is the shared secret for every endpoint.
EnvironmentFile=/etc/envlog/envlog.env
ExecStart=/opt/envlog/.venv/bin/python /opt/envlog/app.py
Restart=on-failure
RestartSec=5

# The service needs to write exactly one directory. Everything else is read-only
# so a bug here cannot reach Pi-hole's configuration on the same box.
StateDirectory=envlog
ReadWritePaths=/var/lib/envlog
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target

# Copy to secrets.yaml and fill in. secrets.yaml is gitignored and must never be
# committed -- the ingest token authenticates every endpoint on the Pi, not just
# /ingest.
#
#   cp esphome/secrets.yaml.example esphome/secrets.yaml
#
# ESPHome looks for secrets.yaml next to the config file it is compiling, so it
# belongs in esphome/, not the repo root.

wifi_ssid: "your-ssid"
wifi_password: "your-wifi-password"

# The same value as ENVLOG_TOKEN in /etc/envlog/envlog.env on the Pi. Print it
# with:  sudo grep -oP '^ENVLOG_TOKEN=\K.*' /etc/envlog/envlog.env
ingest_token: "paste-the-pi-token-here"

# Anything you like; it is only checked on OTA upload. Losing it means flashing
# over USB again, so keep it somewhere.
ota_password: "choose-an-ota-password"
